# 루트 .env로 복사하고 비밀번호를 설정한다. Docker Compose와 Spring local이 함께 읽는다.
POSTGRES_PORT=5432
POSTGRES_DB=dio
POSTGRES_USER=dio
POSTGRES_PASSWORD=
# DB 주소를 변경하면 아래 URL도 함께 수정한다.
DB_URL=jdbc:postgresql://localhost:5432/dio

# 로그인 JWT 서명 전용 비밀키: 무작위 32바이트 이상을 Base64로 변환한 값. 인증번호 비밀키와 별개.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_SECONDS=2592000
# 웹 인증 API를 호출하는 프론트 주소. 여러 주소는 쉼표로 구분한다.
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# 배포용: 신뢰하는 Nginx의 백엔드 연결 IP를 매칭하는 정규식. 실제 Docker 네트워크에 맞춰 설정.
# AUTH_TRUSTED_PROXY_REGEX=

# 메일 발송 설정. 실제 값은 .env 또는 배포 서버의 비공개 환경 파일에서 설정.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SIGNUP_MAIL_FROM=
SIGNUP_VERIFICATION_SECRET=

# 프로필 사진: 로컬은 AWS 계정 없이 파일 저장. backend에서 실행하는 경우의 상대 경로.
SIGNUP_PHOTO_STORAGE=local
SIGNUP_PHOTO_LOCAL_DIRECTORY=.local-data/profile-photos
# S3 사용 시 STORAGE를 s3로 변경하고 실제 버킷/리전을 설정한다.
SIGNUP_PHOTO_S3_BUCKET=
SIGNUP_PHOTO_S3_REGION=ap-northeast-2

# 로컬 데모 다이어리·페이지·캔버스 요소 시드. local 프로필에서만 실행되며 기본값은 비활성이다.
DIO_LOCAL_SEED_ENABLED=false
DIO_LOCAL_SEED_FILE=src/main/resources/db/seed/local-demo.json

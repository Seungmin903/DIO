# 루트 .env로 복사하고 비밀번호를 설정한다. Docker Compose와 Spring local이 함께 읽는다.
POSTGRES_PORT=5432
POSTGRES_DB=dio
POSTGRES_USER=dio
POSTGRES_PASSWORD=
# DB 주소를 변경하면 아래 URL도 함께 수정한다.
DB_URL=jdbc:postgresql://localhost:5432/dio

# 프로필 사진: 로컬은 AWS 계정 없이 파일 저장. backend에서 실행하는 경우의 상대 경로.
SIGNUP_PHOTO_STORAGE=local
SIGNUP_PHOTO_LOCAL_DIRECTORY=.local-data/profile-photos
# S3 사용 시 STORAGE를 s3로 변경하고 실제 버킷/리전을 설정한다.
SIGNUP_PHOTO_S3_BUCKET=
SIGNUP_PHOTO_S3_REGION=ap-northeast-2

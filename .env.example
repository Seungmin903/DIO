# 루트 .env로 복사하고 비밀번호를 설정한다. Docker Compose와 Spring local이 함께 읽는다.
POSTGRES_PORT=5432
POSTGRES_DB=dio
POSTGRES_USER=dio
POSTGRES_PASSWORD=
# DB 주소를 변경하면 아래 URL도 함께 수정한다.
DB_URL=jdbc:postgresql://localhost:5432/dio

# 로그인 JWT 서명 전용 비밀키: 무작위 32바이트 이상을 Base64로 변환한 값. 인증번호 비밀키와 별개.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_SECONDS=2592000
# 웹 인증 API를 호출하는 프론트 주소. 여러 주소는 쉼표로 구분한다.
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# 배포용: 신뢰하는 Nginx의 백엔드 연결 IP를 매칭하는 정규식. 실제 Docker 네트워크에 맞춰 설정.
# AUTH_TRUSTED_PROXY_REGEX=

# 메일 발송 설정. 실제 값은 .env 또는 배포 서버의 비공개 환경 파일에서 설정.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SIGNUP_MAIL_FROM=
SIGNUP_VERIFICATION_SECRET=

# 미디어·프로필 사진 공용 저장소: 로컬은 AWS 계정 없이 파일 저장. backend에서 실행하는 경우의 상대 경로.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIRECTORY=.local-data/media
SIGNUP_PHOTO_LOCAL_DIRECTORY=.local-data/profile-photos
# S3 사용 시 STORAGE를 s3로 변경하고 실제 버킷/리전을 설정한다. 프로필 사진도 같은 값을 쓴다.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-northeast-2

# 공유 초대 전용 32바이트 이상 Base64 비밀키. 미설정 시 링크 기능만 503.
SHARING_INVITE_SECRET=
# 실제 초대 화면 URL/딥링크 접두사. 화면 준비 전 기본 상대 경로.
# 공유 링크용 주소 접두사. 이메일 주소로 지정하는 앱 내 초대에는 절대 URL이 필요하지 않음.
SHARING_INVITE_BASE_URL=/invite/

# 로컬 데모 다이어리·페이지·캔버스 요소 시드. local 프로필에서만 실행되며 기본값은 비활성이다.
DIO_LOCAL_SEED_ENABLED=false
DIO_LOCAL_SEED_FILE=src/main/resources/db/seed/local-demo.json

# 가입 동의 문서의 버전. 프론트 signupPolicy.js와 게시 원문을 함께 배포한다.
SIGNUP_SERVICE_TERMS_VERSION=v2
SIGNUP_PRIVACY_TERMS_VERSION=v2
# 기존 선택 동의 기록 호환용. 새 가입 화면에서는 마케팅 동의를 받지 않는다.
SIGNUP_MARKETING_TERMS_VERSION=v1
# 사진 속 대상 오리기 AI 서버(ai/). 로컬은 ai 폴더에서 uvicorn 을 8000 포트로 실행한다.
# 내부 키는 AI 서버의 DIO_AI_API_KEY 와 같은 값. 로컬에서 둘 다 비우면 키 검사를 하지 않는다. 배포에서는 반드시 설정.
AI_SERVER_URL=http://localhost:8000
DIO_AI_API_KEY=

# 소셜 로그인 서버 검증에 허용할 Google OAuth 클라이언트 ID(쉼표 구분).
# Google Cloud에서 발급한 DIO의 웹/Android/iOS ID만 넣는다. 미설정이면 구글 인증은 비활성.
# client secret 또는 Google 사용자 비밀번호를 넣는 항목이 아니다.
AUTH_GOOGLE_CLIENT_IDS=

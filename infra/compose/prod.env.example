# 비공개 배포 파일에 복사해 실제 값으로 채운다. 이 양식 그대로는 배포할 수 없다.
POSTGRES_DB=dio
POSTGRES_USER=dio
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
SIGNUP_VERIFICATION_SECRET=
SIGNUP_MAIL_FROM=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
AUTH_ALLOWED_ORIGINS=
# 백엔드에서 보이는 실제 Nginx 출발지 IP 정규식 (전체 주소 신뢰 금지)
AUTH_TRUSTED_PROXY_REGEX=
# 미디어·프로필 사진 공용 S3 저장소. 버킷은 필수이며 dev·prod는 서로 다른 버킷을 쓴다.
MEDIA_STORAGE=s3
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-northeast-2
MEDIA_DELETE_RETENTION=PT24H
MEDIA_EXPIRY_CLEANUP_ENABLED=false
SIGNUP_SERVICE_TERMS_VERSION=v2
SIGNUP_PRIVACY_TERMS_VERSION=v2
SIGNUP_MARKETING_TERMS_VERSION=v1
SIGNUP_PHOTO_MIGRATE_LEGACY=false

# 운영 DB 백업(compose.backup.prod.yml). 보관 일수를 바꾸면 개인정보 처리방침의 백업 보관 기간도 고친다.
DB_BACKUP_RETENTION_DAYS=7
# UTC 기준 시각. 18 = 매일 03시 KST.
DB_BACKUP_HOUR_UTC=18

# 공유 링크 전용 키. 링크 기능 사용 전 설정(32바이트 이상 Base64).
SHARING_INVITE_SECRET=
# 공유 링크용 주소 접두사. 이메일 주소로 지정하는 앱 내 초대에는 절대 URL이 필요하지 않음.
SHARING_INVITE_BASE_URL=/invite/

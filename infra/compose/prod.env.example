# 비공개 배포 파일에 복사해 실제 값으로 채운다. 이 양식 그대로는 배포할 수 없다.
POSTGRES_DB=dio
POSTGRES_USER=dio
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
SIGNUP_VERIFICATION_SECRET=
SIGNUP_MAIL_FROM=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
AUTH_ALLOWED_ORIGINS=
# 백엔드에서 보이는 실제 Nginx 출발지 IP 정규식 (전체 주소 신뢰 금지)
AUTH_TRUSTED_PROXY_REGEX=
SIGNUP_PHOTO_S3_BUCKET=
SIGNUP_PHOTO_S3_REGION=ap-northeast-2
SIGNUP_SERVICE_TERMS_VERSION=v1
SIGNUP_PRIVACY_TERMS_VERSION=v1
SIGNUP_MARKETING_TERMS_VERSION=v1
SIGNUP_PHOTO_STORAGE=s3
SIGNUP_PHOTO_MIGRATE_LEGACY=false

# 공유 링크 전용 키. 링크 기능 사용 전 설정(32바이트 이상 Base64).
SHARING_INVITE_SECRET=
# 이메일 초대 사용 시 프론트 초대 화면의 절대 주소로 변경해야 함.
SHARING_INVITE_BASE_URL=/invite/

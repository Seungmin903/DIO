{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": { "DIO_IOS_POINTER_EVENTS": "1" },
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true
    },
    "preview": {
      "env": { "EXPO_PUBLIC_PLANNER_TEMPLATES_ENABLED": "0" },
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "env": { "EXPO_PUBLIC_PLANNER_TEMPLATES_ENABLED": "0" },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

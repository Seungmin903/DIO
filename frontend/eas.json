{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "env": { "DIO_IOS_POINTER_EVENTS": "1", "EXPO_PUBLIC_PUSH_ENABLED": "true", "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" },
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true
    },
    "preview": {
      "env": {
        "DIO_IOS_POINTER_EVENTS": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://k15f106.p.ssafy.io:8444/api",
        "EXPO_PUBLIC_PLANNER_TEMPLATES_ENABLED": "0",
        "EXPO_PUBLIC_PUSH_ENABLED": "true",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
      },
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "env": {
        "DIO_IOS_POINTER_EVENTS": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://k15f106.p.ssafy.io/api",
        "EXPO_PUBLIC_PLANNER_TEMPLATES_ENABLED": "0",
        "EXPO_PUBLIC_PUSH_ENABLED": "true",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

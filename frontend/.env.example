# Android 에뮬레이터에서는 호스트 PC의 localhost 대신 10.0.2.2를 사용합니다.
# 실제 기기에서는 개발 PC의 LAN IP(예: http://192.168.0.10:8080/api)로 바꾸세요.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api
# 웹에서 실행할 때는 http://localhost:8080/api 로 변경한다.
# 개발 Nginx Basic 인증 경유 시만 X-DIO-Access-Token. 로컬/운영은 Authorization 유지.
EXPO_PUBLIC_AUTH_TOKEN_HEADER=Authorization
# 로그인 후 푸시 알림 권한을 요청하고 기기를 등록한다.
EXPO_PUBLIC_PUSH_ENABLED=true

# 실제 게시한 HTTPS 문서 주소. v2 원문을 유지하는 버전별 URL을 넣는다.
# 문서 미게시 상태로도 내부 가입 테스트는 가능하다. 공개 전 세 문서를 게시한다.
# 개인정보처리방침은 수집·이용 동의서와 다른 문서다. 공개 주소만 넣고 비밀번호/토큰은 넣지 않는다.
EXPO_PUBLIC_SERVICE_TERMS_URL=
EXPO_PUBLIC_PRIVACY_CONSENT_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# 마케팅 문서 열람용 선택 주소. 미설정이어도 필수 동의·가입에는 영향을 주지 않는다.
# 선택 항목의 보기 주소이며 광고 발송을 활성화하지 않는다.
EXPO_PUBLIC_MARKETING_PRIVACY_CONSENT_URL=
EXPO_PUBLIC_AD_EMAIL_CONSENT_URL=
EXPO_PUBLIC_AD_PUSH_CONSENT_URL=
EXPO_PUBLIC_AD_NIGHT_PUSH_CONSENT_URL=
# 연결한 백엔드에 V27이 없으면 0으로 두어 플래너 선택을 막는다. 비우면 켜진다. preview/production 빌드 값은 eas.json에 고정되어 있다.
# EXPO_PUBLIC_PLANNER_TEMPLATES_ENABLED=0
# 임시 공동편집 성능 진단. 개발 실행에서만 활성화되며 기본 꺼짐.
# EXPO_PUBLIC_COLLABORATION_DIAGNOSTICS=1

{
  "expo": {
    "name": "DIO",
    "slug": "dio",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#CED9EE"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "다이어리에 사진을 붙이기 위해 사진 보관함에 접근해요."
        }
      ]
    ]
  }
}

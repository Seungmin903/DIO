{
  "expo": {
    "name": "DIO",
    "slug": "dio",
    "owner": "choihans-team",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.f106.DIO",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "다이어리에 사진을 붙이기 위해 사진 보관함에 접근해요."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "다이어리에 사진을 붙이기 위해 사진 보관함에 접근해요.",
          "savePhotosPermission": "완성한 다이어리를 사진첩에 저장하기 위해 사진 추가 권한이 필요해요.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "./plugins/withPointerEvents",
      "./plugins/withHandwritingAndroid",
      "expo-image",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#CED9EE"
        }
      ],
      "expo-asset",
      "expo-font",
      ["expo-status-bar", { "hidden": true }]

    ],
    "extra": {
      "eas": {
        "projectId": "b8670a89-0b9a-4d1f-8d98-ef421e8f5c47"
      }
    },
    "android": {
      "package": "com.f106.DIO",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}

{
  "expo": {
    "name": "DIO",
    "slug": "dio",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#CED9EE"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "다이어리에 사진을 붙이기 위해 사진 보관함에 접근해요."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "다이어리에 사진을 붙이기 위해 사진 보관함에 접근해요.",
          "savePhotosPermission": "완성한 다이어리를 사진첩에 저장하기 위해 사진 추가 권한이 필요해요.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b8670a89-0b9a-4d1f-8d98-ef421e8f5c47"
      }
    },
    "android": {
      "package": "com.f106.DIO"
    }
  }
}

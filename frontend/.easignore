# Local dependency installations and Expo/Metro state are recreated on EAS.
node_modules/
.npm/
.pnpm-store/
.expo/
.env*
!.env.example
*.local
*.jks
*.keystore
*.p12
google-services.json
GoogleService-Info.plist

# Local builds, native build caches, and generated browser output.
/android/
/ios/
dist/
dist-android/
web-build/
.tmp-context-menu-export/

# Logs and editor metadata.
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.vscode/
.idea/

# Generated QA artifacts and Android module build products.
qa/.out/
qa/license-release-*/
third-party/cache/
modules/dio-handwriting/android/build/
modules/dio-handwriting/android/.gradle/
modules/dio-handwriting/android/src/androidTest/assets/
modules/dio-handwriting/android/src/main/assets/dio_handwriting/*.onnx

# The Android asset directory is also the iOS pod's model resource source.
# Include the two prepared inference graphs in EAS uploads.
!modules/dio-handwriting/android/src/main/assets/dio_handwriting/encoder.fp32.onnx
!modules/dio-handwriting/android/src/main/assets/dio_handwriting/decoder.fp32.onnx
